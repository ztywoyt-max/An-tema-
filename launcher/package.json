{
  "name": "anatema-launcher",
  "productName": "ANÁTEMA",
  "version": "1.0.0",
  "description": "Launcher oficial do servidor ANÁTEMA",
  "author": "Equipe ANÁTEMA",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux dir --publish never"
  },
  "dependencies": {
    "@xmcl/core": "2.16.2",
    "electron-updater": "6.8.12",
    "@xmcl/unzip": "2.1.2"
  },
  "devDependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.10.0",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "zustand": "5.0.16",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0"
  },
  "overrides": {
    "@xmcl/unzip": "2.1.2"
  }
}